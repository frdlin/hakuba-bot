# 範本檔案 - 真正的 Key 請填到 .env（不要填這裡！）
# 這個檔案會被推到 GitHub 給其他人參考用，所以絕對不能放真實 Key

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-請填入你的Key

# 知識庫來源 (留空 = 讀 data/knowledge.csv，或填 Google Sheet 發佈到網頁的 CSV 連結)
KNOWLEDGE_SOURCE=

# WhatsApp Cloud API（之後申請）
WHATSAPP_VERIFY_TOKEN=隨機長字串_至少32位
WHATSAPP_ACCESS_TOKEN=之後從Meta後台拿
WHATSAPP_PHONE_NUMBER_ID=之後從Meta後台拿

# LINE Messaging API（之後申請）
LINE_CHANNEL_ACCESS_TOKEN=之後從LINE後台拿
LINE_CHANNEL_SECRET=之後從LINE後台拿

# 經理通知用的 WhatsApp 號碼（人工轉接時用）
MANAGER_WHATSAPP=+886你的台灣號
